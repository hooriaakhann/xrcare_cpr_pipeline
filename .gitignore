# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Video data (large binaries; raw/processed/split are regenerated or
# sourced outside git — see README for how to obtain them) ---
data/raw/
data/processed/
data/split/
data/cache/

# Metadata (CSVs, timestamp sidecars, ground truth) IS tracked — small,
# reproducibility-relevant, and not regenerable without the raw videos.
!data/metadata/
!data/metadata/**

# --- Runs / experiment outputs (local tuning history, not versioned;
# see runs/experiment_ledger.jsonl for the append-only run log) ---
runs/*
!runs/.gitkeep

# --- Testing / tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Isolated ML environments (ADR 0003, not yet written) ---
.venv-torch/
.venv-tf/

# --- Pretrained model checkpoints (large binaries, fetched on demand and
# pinned by URL + sha256 in src/hybrid/models.py — never fine-tuned, see
# CLAUDE.md rule 4) ---
models/

# --- Source clips for README/social-preview assets: show an identifiable
# person's face, unblurred. Never commit these — the blurred versions in
# docs/assets/ are the only ones that belong in git. ---
/gif.mp4
/new gif.mp4
